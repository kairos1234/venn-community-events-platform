# All settings are optional; the defaults below work out of the box.
# The app reads real environment variables (it does not load this file), e.g.:
#   LOG_LEVEL=DEBUG python manage.py runserver 8123

# SQLite database file. Created by `python manage.py migrate`.
EVENTS_DB_PATH=db.sqlite3

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Leave unset: a random key is generated on each start (nothing is signed or stored in
# sessions, so no secret needs to be committed). Set it only if you need a stable key.
# DJANGO_SECRET_KEY=

# Keep false so error responses never include debug pages or stack traces.
DJANGO_DEBUG=false

# Extra allowed Host headers, comma-separated (localhost and 127.0.0.1 are always allowed).
# DJANGO_ALLOWED_HOSTS=
